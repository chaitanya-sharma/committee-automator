# --- REQUIRED for the core pipeline (batch_run.py) ---

# Google Gemini API key (text generation: title/summary/image prompt).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# The Google Sheet ID the pipeline appends rows to.
# Found in the sheet's URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
SHEET_ID=

# ImgBB API key, used to host the final poster image publicly (so the Sheet
# can hold a plain image URL). Get one free at https://api.imgbb.com/
IMGBB_API_KEY=

# --- OPTIONAL (used by operations.py, not called by the default batch_run.py flow) ---

# LinkedIn API access token, only needed if you wire up post_to_linkedin() yourself.
LINKEDIN_ACCESS_TOKEN=

# Google Drive folder ID/URL, only needed if you wire up upload_to_drive() yourself.
# Note: a bare service account has 0GB of personal storage - this only works
# against a Shared Drive folder shared with the service account.
DRIVE_FOLDER_ID=
